# =====================================================================
# Oyejo Gas - Apache configuration (cPanel compatible, Apache 2.4+)
# If the site lives in a subdirectory (e.g. /shop), prefix the
# ErrorDocument paths below, e.g. /shop/errors/404.php
# =====================================================================

Options -Indexes
ServerSignature Off

# --- Friendly error pages (full handler arrives in Phase 25) ---
ErrorDocument 404 /errors/404.php
ErrorDocument 403 /errors/403.php
ErrorDocument 500 /errors/500.php

# --- Block sensitive files everywhere ---
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|log|md)$">
    Require all denied
</FilesMatch>
<Files ".gitignore">
    Require all denied
</Files>

# --- Block internal folders from direct web access ---
# (PHP still reads them from the filesystem: installer, backups, etc.)
RedirectMatch 403 ^/(config|includes|storage|database)(/.*)?$
RedirectMatch 403 ^/(tests|docs|cron)(/.*)?$
RedirectMatch 403 ^/addons(/.*)?$

# --- Security headers ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- PWA: manifest MIME type (Phase 27) ---
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>



# --- PHP defaults (honored on mod_php; harmless on php-fpm) ---
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>
