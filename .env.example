# =====================================================================
# Oyejo Gas - environment template. Copy to ".env" and fill in.
# NEVER commit a real .env to Git. NEVER expose secrets in public files.
# =====================================================================

APP_NAME="Oyejo Gas"
# Public base URL of the site (no trailing slash). Leave empty to auto-detect.
APP_URL=http://localhost:8000
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
# Random per-install secret used to sign links (generated by the installer).
APP_KEY=

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oyejo_gas
DB_USER=root
DB_PASS=

# --- Mail (Phase 22) ---
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Oyejo Gas"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# --- SMS (Phase 22, optional) ---
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=

# --- Notifications (Phase 22) ---
# Worker caps (DB settings notify_rate_per_minute / notify_max_attempts win).
NOTIFY_RATE_PER_MINUTE=30
NOTIFY_MAX_ATTEMPTS=5

# --- WhatsApp (Phase 22) ---
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SENDER=

# --- Payments (Phase 17; enable per gateway) ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# --- Push notifications (Phase 27, optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Cron / scheduled jobs (Phase 24) ---
CRON_TOKEN=change-me-to-a-long-random-string
