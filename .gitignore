# Oyejo Gas
.env
.env.*
!.env.example

# Install lock is per-environment state, never committed
storage/install.lock

# User content & runtime (keep folder guards, ignore payloads)
uploads/*
!uploads/.gitkeep
!uploads/.htaccess
!uploads/index.php
!uploads/banners/
!uploads/banners/.gitkeep
!uploads/banners/index.php
!uploads/branding/
!uploads/branding/.gitkeep
!uploads/branding/index.php
!uploads/products/
!uploads/products/.gitkeep
!uploads/products/index.php
!uploads/categories/
!uploads/categories/.gitkeep
!uploads/categories/index.php
!uploads/payment-proof/
!uploads/payment-proof/.gitkeep
!uploads/payment-proof/index.php
storage/logs/*
!storage/logs/.gitkeep
!storage/logs/index.php
storage/backups/*
!storage/backups/.gitkeep
!storage/backups/index.php
storage/cache/*
!storage/cache/.gitkeep
!storage/cache/index.php

# OS / editor noise
.DS_Store
Thumbs.db
*.log
